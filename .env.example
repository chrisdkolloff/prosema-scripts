# weclapp API credentials (copy this file to .env and fill in your values)
#
# Tenant = subdomain from your weclapp URL, e.g. "mycompany" for
# https://mycompany.weclapp.com
WECLAPP_TENANT=

# API token from weclapp: User menu → My settings → API token
# Desktop scripts/GUI still read this. The web app does not — each signed-in
# user stores their own token (encrypted) under /einstellungen.
WECLAPP_API_TOKEN=

# Fernet key for per-user weclapp tokens in Postgres. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never store this key in the database it protects. See README for rotation.
TOKEN_ENCRYPTION_KEY=

# Shopify Admin API (Dev Dashboard app installed on the store)
# Shop subdomain, e.g. ym109q-ed for https://ym109q-ed.myshopify.com
SHOPIFY_SHOP=ym109q-ed

# From Dev Dashboard → App → Settings
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional short-lived Admin token (shpat_…). If empty/expired, scripts
# refresh via client credentials using CLIENT_ID + CLIENT_SECRET.
SHOPIFY_ACCESS_TOKEN=

# PostgreSQL URL for the web app (SQLAlchemy + psycopg v3).
# If the URL has no sslmode query param, the app adds sslmode=require.
# Local Postgres without TLS must opt out explicitly, e.g.:
# DATABASE_URL=postgresql+psycopg://USER@localhost:5432/prosema_dev?sslmode=disable
DATABASE_URL=

# Secret used to sign the session cookie (generate a long random string)
SESSION_SECRET=

# Entra ID (Azure AD) tenant ID
ENTRA_TENANT_ID=

# App registration application (client) ID
ENTRA_CLIENT_ID=

# App registration client secret
ENTRA_CLIENT_SECRET=

# Redirect URI registered on the app (local: http://localhost:8000/auth/callback)
ENTRA_REDIRECT_URI=

# Object ID of the Entra group PROSEMA-Tools-Users
ENTRA_GROUP_USERS_ID=

# Object ID of the Entra group PROSEMA-Tools-Admins
ENTRA_GROUP_ADMINS_ID=

# local or production
ENVIRONMENT=
